# Copy to .env and fill in, then rename the copy to .env — it is
# gitignored, and this file is not.
#
# Read by the tunnel systemd unit, which keeps the reverse tunnel to the
# API host alive.

# Where the tunnel connects: the VPS user and address.
#     VPS_SSH_TARGET=ifne@203.0.113.10
# Use a dedicated user with the tunnel key in its authorized_keys, not
# root.
VPS_SSH_TARGET=
