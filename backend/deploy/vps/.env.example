# Copy to .env and fill in. Never commit the filled-in file.

# ── Public hostname ───────────────────────────────────────────────────
# Caddy requests a certificate for this name and serves the API on it.
#
#   With a domain you own:  api.example.com
#       Add a DNS A record pointing at this VPS's IP first, or the
#       certificate request fails.
#
#   Without a domain:       203.0.113.10.sslip.io
#       sslip.io resolves to the IP embedded in the name, so a
#       certificate can be issued with no purchase. Free, but the URL
#       looks unusual on a CV.
API_HOSTNAME=

# ── Vision ────────────────────────────────────────────────────────────
VISION_PROVIDER=remote
# The vision service arrives over an SSH reverse tunnel from the CVIS
# host, which binds it to this machine's 127.0.0.1:9099. Inside the API
# container that address is the container itself, so it is reached by
# the name set up in docker-compose.yml instead.
VISION_REMOTE_URL=http://host.docker.internal:9099

# ── Database ──────────────────────────────────────────────────────────
# Supabase pooler connection string. Copy it from the dashboard rather
# than retyping: a single wrong character in the password breaks the URL.
DATABASE_URL=
CATALOG_PROVIDER=sql
NUTRITION_PROVIDER=sql
MEAL_REPOSITORY=sql

# ── Storage ───────────────────────────────────────────────────────────
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=ifne

# ── Limits and CORS ───────────────────────────────────────────────────
# The API holds the image, the masks and the depth map in memory at once,
# so this bounds peak usage on a small host.
MAX_UPLOAD_SIZE_MB=2
# The Vercel origin, exactly as the browser sends it (scheme + host, no
# trailing slash). Multiple origins are comma-separated.
CORS_ORIGINS=https://<your-app>.vercel.app
