# Caddy obtains and renews a Let's Encrypt certificate for whatever
# hostname is set in API_HOSTNAME, and redirects HTTP to HTTPS on its
# own. No certbot run, no renewal cron.
#
# This is required, not optional: the frontend is served from Vercel over
# HTTPS, and browsers refuse to call a plain-HTTP API from an HTTPS page.

{$API_HOSTNAME} {
	encode gzip
	# Both containers share the host's network namespace, so the API is
	# reached on loopback rather than by service name.
	reverse_proxy localhost:8000
}
